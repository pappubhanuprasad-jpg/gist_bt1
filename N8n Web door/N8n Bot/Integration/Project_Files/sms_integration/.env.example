# ---------------------------------------------------------------------------
# College Assistant (n8n) — append these four lines to the project root .env
# Restart uvicorn after editing .env (settings are read once at startup).
# ---------------------------------------------------------------------------

# Switch the chat widget on or off without touching any code.
ASSISTANT_ENABLED=true

# The PRODUCTION webhook URL of the Ask Webhook node in n8n.
# While you are still building, use the test URL (/webhook-test/college-ask)
# and click "Execute workflow" in n8n before every question.
ASSISTANT_URL=https://your-instance.app.n8n.cloud/webhook/college-ask

# The value from the Header Auth credential in n8n (header name: x-college-key).
# This is a secret. Keep it only in local .env; never commit or expose to the browser.
ASSISTANT_KEY=paste-the-long-random-string-here

# How long FastAPI waits for n8n before returning a timeout message, in seconds.
ASSISTANT_TIMEOUT=30
